# 复制为 server/.env 后按需修改（server/.env 已被 .gitignore 忽略）

# ── 运行环境 ───────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# 允许跨域的前端地址，多个用英文逗号分隔；* 表示不限制（仅建议开发环境）
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# 业务日期时区偏移（分钟），480 = UTC+8。数据按 UTC 存储，每日计划按此偏移切分
APP_TIMEZONE_OFFSET_MINUTES=480

# ── MySQL ─────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
# 换成你自己的 MySQL 密码
DB_PASSWORD=your-mysql-password
DB_NAME=beileme
# 自动化测试使用的库（npm run test:server 会自动重建该库）
DB_TEST_NAME=beileme_test
DB_CONNECTION_LIMIT=10

# ── 鉴权 ───────────────────────────────────────────────────
# 生产环境必须替换为随机长字符串，否则服务会拒绝启动：
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev-only-replace-me
ACCESS_TOKEN_TTL=2h
REFRESH_TOKEN_TTL_DAYS=30

# ── AI 生成模块（DeepSeek V4 默认）─────────────────────────
AI_DEFAULT_MODEL=deepseek-v4-pro
# OpenAI 兼容协议接入点；换聚合平台只改这里
# 模型 id 区分大小写，且各账号可用模型可能不同——设置页里点「获取可用模型」最稳妥
AI_BASE_URL=https://api.deepseek.com/v1
# 服务端官方额度。留空时 AI 接口会降级为本地复习清单（不产生费用），
# 用户仍可在设置页填入自己的 Key 来获得 AI 生成内容
AI_API_KEY=
AI_TIMEOUT_MS=60000
AI_TEMPERATURE=1.0

# ── AI 成本控制 ────────────────────────────────────────────
# 输出 token 上限（这是「天花板」而不是「预留」：模型写完就停，用不到不收费）。
# 因此设小了会真的失败（JSON 被截断 → 白白多花一次重试），设大了几乎不花钱。
# 下面几个数字来自真实调用实测（DeepSeek，已关掉内部思考）：
#   短文 230 词   567 输出   理解题 3 题   1454 输出
#   错词卡片 6 张 2213 输出  一周小结       349 输出
# 用户可在设置页覆盖这些值，无需改这里。
AI_MAX_TOKENS_ARTICLE=1000
AI_MAX_TOKENS_QUIZ=2000
AI_MAX_TOKENS_CARD_BATCH=3200
AI_MAX_TOKENS_SUMMARY=600
# 单次输入 token 预算：预计超过就自动减少目标词数量，而不是把长 Prompt 发出去
AI_MAX_INPUT_TOKENS=2000
# 仅在「允许模型内部思考」时才生效的额度放宽倍数。
# 默认会请求服务商跳过内部思考（实测可避免额度被思考吃光），此时不乘这个倍数
AI_REASONING_BUDGET_MULTIPLIER=3
# 用户自带 Key 时的额度放宽倍数（仅防滥用，不限制正常使用）
AI_USER_KEY_QUOTA_MULTIPLIER=20
# 单价（美元 / 百万 token），仅用于估算与展示，不影响真实计费。
# 换厂商或官方调价后请同步修改；全部设为 0 则界面只显示 token 数。
AI_PRICE_INPUT_PER_M=0.27
AI_PRICE_OUTPUT_PER_M=1.10
AI_PRICE_CACHED_INPUT_PER_M=0.07

# 每日生成次数上限（仅作用于服务端官方额度）
AI_DAILY_ARTICLE_QUOTA=3
AI_DAILY_QUIZ_QUOTA=3
AI_DAILY_ERROR_CARD_QUOTA=10
AI_DAILY_WEAK_SUMMARY_QUOTA=2
# 缓存复用：命中间隔（小时）内相同词组合优先复用历史生成内容（PRD 4.3.6）
AI_CONTENT_CACHE_HOURS=72

# 用户自带 API Key 的加密主密钥。留空则从 JWT_SECRET 派生。
# 注意：变更后已保存的 Key 将无法解密，用户需要重新填写。
AI_KEY_ENCRYPTION_SECRET=
