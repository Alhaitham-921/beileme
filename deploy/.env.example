# Generate deploy/.env with: sh deploy/init-env.sh
COMPOSE_PROJECT_NAME=beileme
WEB_PORT=8088
# Replace with the exact HTTPS origin after the domain proxy is configured.
PUBLIC_ORIGIN=http://localhost:8088
# Optional comma-separated previous origins retained while switching domains.
EXTRA_CORS_ORIGINS=
DB_NAME=beileme
DB_USER=beileme
DB_PASSWORD=
DB_ROOT_PASSWORD=
JWT_SECRET=
AI_KEY_ENCRYPTION_SECRET=
ADMIN_USER_IDS=
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_DEFAULT_MODEL=deepseek-v4-pro
WORD_IMAGE_API_KEY=
WORD_IMAGE_BASE_URL=https://api.siliconflow.cn/v1
WORD_IMAGE_MODEL=Kwai-Kolors/Kolors
WORD_IMAGE_DAILY_QUOTA=5
SPEECH_API_KEY=
SPEECH_BASE_URL=https://api.siliconflow.cn/v1
SPEECH_MODEL=FunAudioLLM/SenseVoiceSmall
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=背了么
KOKORO_THREADS=2
