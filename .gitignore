# 依赖
node_modules/

# npm 本地缓存（沙箱环境下使用 --cache .npm-cache 安装）
.npm-cache/

# 开源词库的下载缓存（可重新下载，不入库）
server/data/wordlists/

# 构建产物
# npm run build 的输出是 dist/index.html（单文件插件会把 JS/CSS 全部内联进去）
dist/
dist-ssr/

# 本地 Claude Code 设置（不提交）
.claude/settings.local.json

# 日志
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 环境变量（可能含密钥）
.env
.env.local
.env.*.local

# 编辑器 / 系统
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.sw?
