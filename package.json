{
  "name": "beileme",
  "version": "0.2.12",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server/src/server.js",
    "server:dev": "node --watch server/src/server.js",
    "db:migrate": "node server/src/db/migrate.js",
    "db:seed": "node server/src/db/seed.js",
    "db:import": "node server/src/db/importWordlists.js",
    "db:setup": "node server/src/db/migrate.js && node server/src/db/importWordlists.js",
    "db:ielts": "node scripts/seed-ielts.mjs",
    "db:backup": "node scripts/backup-db.mjs",
    "test:ielts:unit": "node --test server/tests/unit.ieltsEngine.test.js",
    "test:server": "node --test --test-isolation=none --test-force-exit \"server/tests/*.test.js\"",
    "start:all": "concurrently \"npm run dev\" \"npm run server:dev\"",
    "ai:calibrate": "node server/src/db/calibrateAi.js",
    "admin:grant": "node scripts/grant-admin.mjs",
    "android:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android.ps1 -Action Setup",
    "android:doctor": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android.ps1 -Action Doctor",
    "android:sync": "vite build --mode android && cap sync android",
    "android:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android.ps1 -Action Build",
    "android:connect": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android.ps1 -Action Connect",
    "android:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android.ps1 -Action Install"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.4",
    "nodemailer": "^10.3.1",
    "pinia": "^2.3.0",
    "sharp": "^0.35.5",
    "ts-fsrs": "^6.0.0",
    "undici": "^8.12.4",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^10.0.5",
    "vite": "^6.0.7",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
