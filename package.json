{
  "name": "beileme",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server/src/server.js",
    "server:dev": "node --watch server/src/server.js",
    "db:migrate": "node server/src/db/migrate.js",
    "db:seed": "node server/src/db/seed.js",
    "db:import": "node server/src/db/importWordlists.js",
    "db:setup": "node server/src/db/migrate.js && node server/src/db/importWordlists.js",
    "test:server": "node --test --test-isolation=none --test-force-exit \"server/tests/*.test.js\"",
    "start:all": "concurrently \"npm run dev\" \"npm run server:dev\"",
    "ai:calibrate": "node server/src/db/calibrateAi.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.4",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^10.0.5",
    "vite": "^6.0.7",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
